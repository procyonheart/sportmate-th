# ── Server ──
PORT=8080
HOST=0.0.0.0

# ── Database (Neon / Supabase / Render Postgres connection string) ──
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ── Frontend ──
SITE_URL=https://procyonheart.github.io/sportmate-th
CORS_ORIGINS=https://procyonheart.github.io,http://localhost:3000

# ── Email (Resend). Leave blank in dev to log emails to console instead ──
RESEND_API_KEY=
MAIL_FROM=SportMate TH <onboarding@resend.dev>
ADMIN_EMAIL=

# ── Image storage (Cloudinary). Leave blank in dev to pass images through ──
CLOUDINARY_URL=
